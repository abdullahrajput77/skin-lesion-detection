import streamlit as st
import torch
import torch.nn as nn
import torchvision.transforms as transforms
from PIL import Image
import numpy as np

# 1. Define the exact same SimpleCNN architecture
class SimpleCNN(nn.Module):
    def __init__(self):
        super(SimpleCNN, self).__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 16, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),

            nn.Conv2d(16, 32, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),

            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2)
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(64 * 16 * 16, 128),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(128, 2)
        )

    def forward(self, x):
        x = self.features(x)
        x = self.classifier(x)
        return x

# 2. Set Page Configuration
st.set_page_config(
    page_title="Skin Lesion Classifier",
    page_icon="🩺",
    layout="centered"
)

st.title("🩺 Skin Lesion Classification App")
st.write("Upload a skin lesion image to classify it as **Benign** or **Malignant**.")

# 3. Load the pre-trained weights
@st.cache_resource
def load_model():
    model = SimpleCNN()
    # Using map_location='cpu' ensures it runs on both GPU and CPU servers
    model.load_state_dict(torch.load('skin_lesion_cnn.pth', map_location=torch.device('cpu')))
    model.eval()
    return model

try:
    model = load_model()
    st.success("Model weights loaded successfully!")
except Exception as e:
    st.error(f"Failed to load 'skin_lesion_cnn.pth'. Please ensure the model file is in the same directory. Error: {e}")

# 4. Image Preprocessing matching your notebook
transform = transforms.Compose([
    transforms.Resize((128, 128)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

# 5. Class Mapping
class_names = ['Benign', 'Malignant']

# 6. File Uploader
uploaded_file = st.file_uploader("Choose a skin lesion image...", type=["jpg", "jpeg", "png"])

if uploaded_file is not None:
    # Display the uploaded image
    image = Image.open(uploaded_file).convert('RGB')
    st.image(image, caption='Uploaded Image', use_container_width=True)
    
    # Preprocess and Predict
    with st.spinner("Analyzing image..."):
        # Apply exact transformations
        img_tensor = transform(image).unsqueeze(0) # Add batch dimension
        
        with torch.no_grad():
            outputs = model(img_tensor)
            # Calculate probabilities using Softmax
            probabilities = torch.nn.functional.softmax(outputs, dim=1)[0]
            confidence, prediction = torch.max(probabilities, 0)
            
        predicted_class = class_names[prediction.item()]
        confidence_percentage = confidence.item() * 100
        
        # Display Results
        st.write("--- ")
        if predicted_class == 'Malignant':
            st.error(f"**Prediction: {predicted_class}**")
        else:
            st.success(f"**Prediction: {predicted_class}**")
            
        st.metric(label="Confidence Score", value=f"{confidence_percentage:.2f}%")
